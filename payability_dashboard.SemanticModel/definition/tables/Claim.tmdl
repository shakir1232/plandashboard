table Claim
	lineageTag: 6192e3fc-8786-4326-bcfb-0f3a8b1b5acc

	measure 'Total Claims' = DISTINCTCOUNT(Claim[Id])
		formatString: 0
		lineageTag: a623cccb-5fa4-455f-84f5-35c594aca4bb

	measure 'Total Claim Amount' = SUM(Claim[InvoiceAmount])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f4a63a6e-1c1f-4d6d-9750-eaf391bc8fc7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% of Total Amount' =
			
			DIVIDE(
			    [Total Claim Amount],
			    CALCULATE([Total Claim Amount], ALL(Claim))
			)
		lineageTag: bf4f2926-9dbd-4025-b16d-3885cd9b6b22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

